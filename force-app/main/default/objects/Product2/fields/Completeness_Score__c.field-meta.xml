<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completeness_Score__c</fullName>
    <formula>ROUND( ( IF(NOT(ISBLANK(ProductCode)),1,0) + IF(NOT(ISBLANK(Description)),1,0) + IF(NOT(ISBLANK(Text(Family))),1,0) + IF(NOT(ISBLANK(TEXT(Lifecycle_Status__c))),1,0) + IF(NOT(ISBLANK(Text(Type))),1,0)) / 6 , 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Completeness Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
