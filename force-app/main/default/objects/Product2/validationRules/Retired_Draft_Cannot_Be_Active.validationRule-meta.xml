<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Retired_Draft_Cannot_Be_Active</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Lifecycle_Status__c, &quot;Retired&quot;),
        ISPICKVAL(Lifecycle_Status__c, &quot;Draft&quot;)
    ),
    IsActive
)</errorConditionFormula>
    <errorDisplayField>IsActive</errorDisplayField>
    <errorMessage>Retired or Drafted products cannot be Active.</errorMessage>
</ValidationRule>
