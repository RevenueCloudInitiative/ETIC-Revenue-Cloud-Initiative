                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_Thresholds.Min_Quote_Value__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>formTotalPriceUSD</elementReference>
                </rightValue>
            </conditions>
            <conditions>
